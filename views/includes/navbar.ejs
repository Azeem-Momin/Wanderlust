<nav class="navbar navbar-expand-md bg-white border-bottom sticky-top z-index-1">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="/listings">
            <i class="fa-regular fa-compass me-1"></i>
            <span style="color: #fe424d; font-weight: bold;">Wanderlust</span>
        </a>

        <!-- Hamburger button -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar content that will collapse on small screens -->
        <div class="collapse navbar-collapse bg-white" id="navbarNavAltMarkup">
            <br>
            <!-- Search form -->
            <div class="navbar-nav ms-auto">
                <form class="d-flex" role="search" method="GET" action="/listings/search">
                    <input class="form-control me-2 search-inp" type="text" placeholder="Search by Country"
                        name="country" pattern="^[^\d]*$" required>
                    <button class="btn search-btn" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i>Search
                    </button>
                </form>
            </div>

            <!-- Navigation links -->
            <div class="navbar-nav ms-auto">
                <a class="nav-link fw-semibold" href="/listings/new">Add new Listings</a>
                <% if(!currUser){ %>
                    <a class="nav-link" href="/signup"><b>Sign up</b></a>
                    <a class="nav-link" href="/login"><b>Log in</b></a>
                    <% } %>
                        <% if(currUser){ %>


                            <a href="/user/profile" class="text-decoration-none">
                                <div class="me-2 d-inline-flex flex-column align-items-center">
                                    <% if (currUser.profilePicture) { %>
                                        <img src="<%= currUser.profilePicture %>" alt="Profile Picture"
                                            class="rounded-circle" style="width: 40px; height: 40px;">
                                        <% } else { %>
                                            <i class="fa-regular fa-circle-user fs-3 profile"
                                                style="color: #fe424d;"></i>
                                            <% } %>
                                                <p style="font-size: 9px; margin: 0; color: #fe424d;"><b>Profile</b></p>
                                </div>
                            </a>



                            <!-- <a class="nav-link" href="/logout"><b>Log out</b></a> -->
                            <% } %>
            </div>
        </div>
    </div>
</nav>


<script>
    document.querySelector('form').addEventListener('submit', function (event) {
        const searchInput = document.querySelector('.search-inp');

        // Check if the input is empty or contains only whitespace
        if (!searchInput.value.trim()) {
            searchInput.classList.add('is-invalid');
            event.preventDefault(); // Prevent form submission
        } else {
            searchInput.classList.remove('is-invalid');
        }
    });
</script>