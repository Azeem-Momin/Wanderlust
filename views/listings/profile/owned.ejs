<% layout("/layouts/boilerplate") %>

    <body>


        <% if(allListings.length> 0){ %>
            <div class="d-flex justify-content-center flex-nowrap overflow-hidden position-relative m-3">
                <h3>Listings owned by you.</h3>
            </div><br>
            <% } %>


                <!-- Display tax toggle -->
                <% if(allListings.length> 0){ %>
                    <div class="container">
                        <div class="row">
                            <div class="ms-auto">
                                <div class="tax-toggle d-flex justify-content-center align-items-center ms-auto">
                                    <div class="form-check form-switch form-check-reverse responsive-toggle">
                                        <label class="form-check-label text-nowrap text-center tax-content"
                                            for="flexSwitchCheckDefault">Display total after
                                            tax</label>
                                        <input class="form-check-input tax-button" type="checkbox" role="switch"
                                            id="flexSwitchCheckDefault">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>



                        <% if(allListings.length===0){ %>
                            <div class="mt-2">
                                <h3>No listings owned by you.</h3>
                            </div>
                            <% } %>
                                <!-- listings code -->
                                <div class="row row-cols-lg-3 row-cols-mid-2 row-cols-sm-2 row-cols-xm--2 mt-3">


                                    <% for(let listing of allListings){ %>
                                        <% if (listing) { %>
                                            <a href="/listings/<%= listing._id %>" class="listing-link">
                                                <div class="card col listing-card">
                                                    <img class="card-img-top" src="<%= listing.image.url %>"
                                                        alt="listing_image" style="height: 20rem;">
                                                    <!-- Heart icon -->
                                                    <div class="card-img-overlay">
                                                        <i class="fa-heart <%= listing.likes.includes(currentUserId) ? 'fa-solid' : 'fa-regular' %>"
                                                            onclick="toggleLike(event, '<%= listing._id %>')"></i>

                                                    </div>
                                                    <div class="card-body">
                                                        <p class="card-text">
                                                            <b>
                                                                <%= listing.title %>
                                                            </b><br>
                                                            <%= listing.price.toLocaleString("en-IN") %>/night
                                                                <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
                                                        </p>
                                                    </div>
                                                </div>
                                            </a>
                                            <% } %>
                                                <% } %>
                                </div>



                                <script src="/js/homePage.js"></script>
    </body>