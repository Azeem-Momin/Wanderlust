            <form action="/listings/categories/category" method="GET" id="categoryForm">
                <input type="hidden" name="category" value="domes">
                <button type="submit"
                    style="background: none; border: none; padding: 0; margin: 0; display: block; width: 100%;">
                    <div class="filter">
                        <div><i class="fa-solid fa-igloo"></i></a></div>
                        <p>Domes</p>
                    </div>
                </button>
