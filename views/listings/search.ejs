        </div>
        <button class="scroll-btn right-btn" onclick="scrollContentRight()">&#8250;</button>

    </div>

    <!-- Display tax toggle -->
    <div class="container">
        <div class="row">
            <div class="ms-auto">
                <div class="tax-toggle d-flex justify-content-center align-items-center ms-auto">
                    <div class="form-check form-switch form-check-reverse responsive-toggle">
                        <label class="form-check-label text-nowrap text-center tax-content"
                            for="flexSwitchCheckDefault">Display total after
                            tax</label>
                        <input class="form-check-input tax-button" type="checkbox" role="switch"
                            id="flexSwitchCheckDefault">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <% if(allListings.length==0) { %>
        <h3 style="margin-top: 1rem;">No listings of the given country have been added.</h3>
        <% } else { %>

            <h3 class="mt-3"><b>Country : <%= allListings[0].country %></b></h3>
            <div class="row row-cols-lg-3 row-cols-mid-2 row-cols-sm-2 row-cols-xm--2 mt-3">
                <% for(let listing of allListings){ %>


                    <a href="/listings/<%= listing._id %>" class="listing-link">
                        <div class="card col listing-card">
                            <img class="card-img-top" src="<%= listing.image.url %>" alt="listing_image"
                                style="height: 20rem;">
                            <!--listing.image extract image from db-->

                            <div class="card-img-overlay">
                                <i class="fa-heart <%= listing.likes.includes(currentUserId) ? 'fa-solid' : 'fa-regular' %>"
                                    onclick="toggleLike(event, '<%= listing._id %>')"></i>
                            </div>
                            <div class="card-body">
                                <p class="card-text">
                                    <b>
                                        <%= listing.title %>
                                    </b> <br>
                                    <%= listing.price.toLocaleString("en-IN") %>/night
                                        <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
                                </p>
                            </div>
                        </div>
                    </a>
                    <% } %>
            </div>
            <% } %>


                <script src="/js/homePage.js"></script>