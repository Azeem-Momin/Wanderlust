<% layout("/layouts/boilerplate") %>

    <body>
        <div class="container row mt-5 d-flex justify-content-space-evenly">

            <div class="col-md-6 d-flex flex-column align-items-center mb-5">


                <div style="position: relative; width: 18rem; height: 18rem;">
                    <!-- User Profile Picture -->
                    <img src="<%= user.profilePicture && user.profilePicture.url ? user.profilePicture.url : '' %>" 
                         alt="Profile Picture" 
                         class="profile-picture" 
                         style="width: 18rem; height: 18rem;" 
                         onError="this.style.display='none'; this.nextElementSibling.style.display='inline-block';">
                    
                    <!-- Font Awesome Icon (fallback) -->
                    <i class="fa-regular fa-circle-user profile" 
                       style="color: #fe424d; font-size: 18rem; position: absolute; top: 0; left: 0; display: none;"></i>
                </div>
                
                

                <h1 class="mt-2">
                    <%= user.username %>
                </h1>
                <p>Email: <%= user.email %>
                </p>
                <button class="btn btn-dark logout-btn"><a class="nav-link" href="/logout"><b>Logout</b></a></button>
            </div>


            <div class="col-md-6 d-flex flex-column align-items-center">

                <form action="/listings/user/owned" method="GET">
                    <button type="submit" style="all: unset;">
                        <div class="listing-filter text-center">
                            <h3>Owned Listings <i class="ml-2  fa-solid fa-arrow-right"
                                    style="vertical-align: middle;"></i>
                            </h3>
                        </div>
                    </button>
                </form>

                <form action="/listings/user/liked" method="GET">
                    <button type="submit" style="all: unset;">
                        <div class="listing-filter text-center">
                            <h3>Liked Listings <i class="ml-2  fa-solid fa-arrow-right"
                                    style="vertical-align: middle;"></i>
                            </h3>
                        </div>
                    </button>
                </form>

                <form action="/listings/user/booked" method="GET">
                    <button type="submit" style="all: unset;">
                        <div class="listing-filter text-center">
                            <h3>Booked Listings <i class="ml-2  fa-solid fa-arrow-right"
                                    style="vertical-align: middle;"></i>
                            </h3>
                        </div>
                    </button>
                </form>

                <form action="/listings/user/reviews" method="GET">
                    <button type="submit" style="all: unset;">
                        <div class="listing-filter text-center">
                            <h3>Your Reviews <i class="ml-2  fa-solid fa-arrow-right"
                                    style="vertical-align: middle;"></i>
                            </h3>
                        </div>
                    </button>
                </form>

            </div>
        </div>

        </div>


        <!-- <script src="/js/homePage.js"></script> -->
    </body>